# CD4PE UI nginx config for Kubernetes.
# Derived from cd4peadm 5.18.0 templates/nginx/base.conf.template.epp. Changes:
#   - TLS removed from :3000, the ingress controller terminates it
#   - webhook server block removed, the backend ingress goes straight to pipelinesinfra:8000
#   - logs go to stdout/stderr instead of /app/logs
# CD4PE_SERVICE and QUERY_SERVICE are filled in by the image's envsubst step at start.
events {
    worker_connections 1024;
}

http {
    include            /etc/nginx/mime.types;
    sendfile           on;
    keepalive_timeout  70;

    # Non-GET requests made to an endpoint starting with /cd4pe should always be
    # routed to the CD4PE backend. Teams UI only handles GET requests.
    map $request_method $verb_check {
        default @cd4pebackend;
        GET @reactui;
    }

    # Requests for a legacy page made by teams UI has the X-NODE-PROXY header
    # set to enabled. Requests with this header should be proxied to the CD4PE
    # backend
    map $http_x_node_proxy $legacy_page_check {
        default $verb_check;
        enable @cd4pebackend;
    }

    # Server config
    server {
        listen  *:3000;
        # TODO only add the IPv6 address if IPv6 is enabled
        listen  [::]:3000;



        # Set default server
        server_name _;

        # disable showing nginx version on error pages & in “Server” response header field
        server_tokens off;

        # max upload size
        client_max_body_size 75M;

        # Logging
        access_log /dev/stdout;
        error_log /dev/stderr;

        # all redirects should be relative
        absolute_redirect off;

        # How long to wait for requests proxied through to the CD4PE service to complete
        proxy_read_timeout 300s;

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;
        # style-src allows unsafe-inline because CodeMirror 6 injects its theme/gutter
        # CSS as runtime <style> elements, and the legacy frontend's webpack bundles
        # do the same via style-loader. A per-request nonce would avoid the
        # unsafe-inline carve-out, but Jetty serves the legacy bundles as static,
        # pre-built HTML with no per-request templating to inject a matching nonce
        # into both the CSP header and the page, so nonces aren't viable without a
        # legacy frontend rework.
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;

        # Migrated pages redirects
        rewrite ^/cd4pe/([^/]+)/jobs/(\d+)$ /$1/code-delivery/jobs/$2 redirect;
        rewrite ^/cd4pe/([^/]+)/jobs$ /$1/code-delivery/jobs/templates redirect;
        rewrite ^/cd4pe/([^/]+)/settings/groups$ /$1/settings/groups redirect;
        rewrite ^/cd4pe/([^/]+)/settings/users$ /$1/settings/users redirect;
        rewrite ^/cd4pe/([^/]+)/settings/ssh$ /$1/settings/ssh redirect;
        rewrite ^/cd4pe/([^/]+)/settings/add-users$ /$1/settings/users/add redirect;
        rewrite ^/cd4pe/(?!root\/)([^/]+)/settings/puppet-enterprise$ /$1/settings/puppet-enterprise redirect;
        rewrite ^/cd4pe/(?!root\/)([^/]+)/settings$ /$1/settings/workspace redirect;
        rewrite ^/cd4pe/([^/]+)/settings/workspaces$ /$1/settings/workspace redirect;
        rewrite ^/cd4pe/root/?$ /root/accounts redirect;
        rewrite ^/cd4pe/([^/]+)/settings/integrations$ /$1/settings/source-control redirect;
        rewrite ^/cd4pe/(?!root\/)([^/]+)/job-hardware$ /$1/code-delivery/job-hardware redirect;
        rewrite ^/cd4pe/(?!root\/)([^/]+)/job-hardware-capability$ /$1/code-delivery/job-hardware/new? redirect;
        rewrite ^/cd4pe/403 /403 redirect;
        rewrite ^/cd4pe/404 /404 redirect;
        rewrite ^/cd4pe/forgot-password /forgot-password redirect;
        rewrite ^/cd4pe/reset-password /reset-password redirect;
        rewrite ^/cd4pe/([^/]+)/choose-workspace$ /$1/choose-workspace redirect;
        rewrite ^/cd4pe/([^/]+)/repositories$ /$1/code-delivery/repositories redirect;
        rewrite ^/cd4pe/([^/]+)/modules$ /$1/code-delivery/modules redirect;
        rewrite ^/cd4pe/([^/]+)/profile$ /$1/profile redirect;
        rewrite ^/cd4pe/([^/]+)/repositories/([^/]+)$ /$1/code-delivery/repositories/$2 redirect;
        rewrite ^/cd4pe/([^/]+)/modules/([^/]+)$ /$1/code-delivery/modules/$2 redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/?$ /root/puppet-enterprise redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/new/?$ /root/puppet-enterprise/new redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/([^/]+)/?$ /root/puppet-enterprise/$1 redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/([^/]+)/environments/?$ /root/puppet-enterprise/$1/environments redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/([^/]+)/environments/([^/]+)/?$ /root/puppet-enterprise/$1/environments/$2 redirect;
        rewrite ^/cd4pe/root/settings/puppet-enterprise/([^/]+)/regenerate/?$ /root/puppet-enterprise/$1/regenerate redirect;
        rewrite ^/root/settings/puppet-enterprise/?$ /root/puppet-enterprise redirect;
        rewrite ^/root/settings/puppet-enterprise/new/?$ /root/puppet-enterprise/new redirect;
        rewrite ^/root/settings/puppet-enterprise/([^/]+)/environments/?$ /root/puppet-enterprise/$1/environments redirect;
        rewrite ^/root/settings/puppet-enterprise/([^/]+)/environments/([^/]+)/?$ /root/puppet-enterprise/$1/environments/$2 redirect;
        rewrite ^/root/settings/puppet-enterprise/([^/]+)/regenerate/?$ /root/puppet-enterprise/$1/regenerate redirect;
        rewrite ^/root/settings/puppet-enterprise/([^/]+)/?$ /root/puppet-enterprise/$1 redirect;



        # Internal API should not be accessible
        location ~ ^/cd4pe/api/(v[0-9]+)/internal/ {
            return 403;
        }

        # CD4PE API and public assets served by CD4PE
        location ~ ^/cd4pe/(api|public)/ {
            rewrite /cd4pe/(.+) /$1 break;
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        location ~ ^/cd4pe/([^/]+)/getJobScriptAndControlRepo$ {
            rewrite /cd4pe/(.+) /$1 break;
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        # Health check endpoints used by k8s
        location = /cd4pe/status {
            proxy_pass ${CD4PE_SERVICE}/status;
            proxy_set_header Host $host;
        }

        location = /status {
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        # old SAML auth endpoint (v4.21.0->v4.21.1)
       location = /cd4pe/saml-auth {
           proxy_pass ${CD4PE_SERVICE}/saml-auth;
           proxy_set_header Host $host;
       }

       # SAML auth endpoint (v4.22.0 +)
       location = /saml-auth {
           proxy_pass ${CD4PE_SERVICE}/saml-auth;
           proxy_set_header Host $host;
       }

        # Ajax endpoints
        location ~ ^/cd4pe/([^/]+)/ajax {
            rewrite /cd4pe/([^/]+)/ajax /$1/ajax break;
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        location ~ ^/([^/]+)/ajax {
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        # All other URL's under /cd4pe need to be redirected to the react UI or
        # the cd4pe backend depending on the X-NODE-PROXY header and the verb
        # used. Since the config for this location is different for dev and prod
        # we use try files to redirect to a named location (@cd4pebackend or
        # @reactui). @reactui is defined in an overrides file since that config
        # is different between dev and prod. try_files requires 2 args so the
        # first arg is just a path does does not exist so that it fallsback to
        # the named location.
        location ~ ^/cd4pe {
            try_files /THISDOESNOTEXIST $legacy_page_check;
        }

        # Named location used by the /cd4pe location
        location @cd4pebackend {
            rewrite /cd4pe$ / break;
            rewrite /cd4pe/(.+) /$1 break;
            proxy_pass ${CD4PE_SERVICE};
            proxy_set_header Host $host;
        }

        root /www/static/;

        # Fallback to static files
        location / {
            try_files $uri /index.html =404;
        }

        # Named location used by the /cd4pe
        # Can't cache static pages that share the same URL as pages served directly by
        # the CD4PE backend.
        location @reactui {
            try_files $uri /index.html =404;
            add_header Last-Modified $date_gmt;
            add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0';
            if_modified_since off;
            expires off;
            etag off;
        }

        location = /query {
          proxy_pass ${QUERY_SERVICE};
          proxy_set_header Host $host;
        }

        location = /export {
          proxy_pass ${QUERY_SERVICE};
          proxy_set_header Host $host;
        }
    }
}
