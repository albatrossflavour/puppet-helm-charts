{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cd4pe chart values",
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array"
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "hostname": {
      "type": "string"
    },
    "backendHostname": {
      "type": "string"
    },
    "rootUser": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "rootPassword": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "postgresPassword": {
          "type": "string"
        },
        "cd4peDbPassword": {
          "type": "string"
        },
        "queryDbPassword": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "keepOnUninstall": {
      "type": "boolean"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "initImage": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            },
            "backendSecretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "pipelinesinfra": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "javaArgs": {
          "type": "string"
        },
        "extraEnv": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "INFO",
            "DEBUG",
            "TRACE"
          ]
        },
        "extraEnv": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "queryToken": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "accessMode": {
              "type": "string",
              "enum": [
                "ReadWriteMany",
                "ReadWriteOnce"
              ]
            },
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^$|^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "rootCredentialsJob": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
