# Generated by port/generate_files.py from complyadm templates/mtls_proxy/nginx_conf.epp. Do not edit.
# Changed from the module's version:
#   - upstreams are Service names in upstream blocks, so no docker resolver
#   - the error log is at notice, not debug
# The chart replaces the FULLNAME placeholder.
worker_processes auto;

error_log /dev/stderr notice;

events {
  worker_connections 8192;
}

http {

  # omit nginx server version
  server_tokens off;
  upstream comply_scarpy {
    server @@FULLNAME@@-scarpy:8088;
  }

  upstream comply_ui {
    server @@FULLNAME@@-ui:3001;
  }

  server {
    listen 8081;

    location /health {
      access_log off;
      add_header Content-Type text/plain;
      return 200 'OK';
    }
  }

  server {
    #include /etc/nginx-resolver/resolver.conf;

    # backlog option should match or exceed somaxconn on the underyling
    # k8s _node_, if this value exceeds somaxconn it will be silently
    # truncated which is fine, we just don't want the backlog (which
    # defaults to 512) to be smaller than somaxconn.
    listen 8080 ssl backlog=4096;

    ssl_certificate         /certs/tls.crt;
    ssl_certificate_key     /certs/tls.key;
    ssl_protocols           TLSv1.2;
        ssl_client_certificate /certs/ca.crt;
    ssl_verify_client       on;
        ssl_verify_depth        10;

    location /api/v3/core/store/report {
        # These three directives disable request buffering so that nginx
        # doesn't accept requests faster than the upstream can accept them.
        client_max_body_size 0;
        proxy_http_version 1.1;
        proxy_request_buffering off;

        proxy_pass  http://comply_scarpy/api/v3/core/store/report;
    }

    location /api/v3/uc/store-report {
        # Same as /api/v3/core/store/report above -- without an explicit
        # location, this path fell through to nginx's default 1MB
        # client_max_body_size and rejected report uploads with 413 before
        # they ever reached scarp.
        client_max_body_size 0;
        proxy_http_version 1.1;
        proxy_request_buffering off;

        proxy_pass  http://comply_scarpy/api/v3/uc/store-report;
    }

    location /api/v3/core/assessorVersion {
        proxy_pass  http://comply_scarpy/api/v3/core/assessorVersion;
    }

    location /api/v3/core/desiredCompliance {
        proxy_pass  http://comply_scarpy/api/v3/core/desiredCompliance$is_args$args;
    }

    location /assessor/windows {
        proxy_pass  http://comply_ui/files/assessor/windows;
    }

    location /assessor/linux {
        proxy_pass  http://comply_ui/files/assessor/linux;
    }

    location /assessor/mac {
        proxy_pass  http://comply_ui/files/assessor/mac;
    }

  }
}
