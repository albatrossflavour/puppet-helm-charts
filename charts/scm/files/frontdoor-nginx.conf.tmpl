# Generated by port/generate_files.py from complyadm templates/frontdoor/nginx_conf.epp. Do not edit.
# Changed from the module's version:
#   - TLS and the 8080 to 8443 redirect removed, the ingress controller terminates TLS
#   - the one server block listens on plain 8080
#   - upstreams are Service names, resolved at start, so no docker resolver
#   - X-Forwarded-Proto is fixed at https, since the ingress is the only way in
# The chart replaces the FULLNAME placeholder, and switches the /auth/admin block on frontdoor.keycloakAdminConsole.
pid /var/run/nginx.pid;

# set the number of worker processes based on the number of CPU cores
worker_processes auto;

# set a generous time limit for gracefully shutting down worker processes
worker_shutdown_timeout 60s;

# set limits on the maximum number of open files and simultaneous connections per worker process
# this is an educated guess on reasonable values (must have worker_rlimit_nofile > worker_connections)
worker_rlimit_nofile 16384;
events {
    worker_connections 8192;
}

http {

    # omit nginx server version
    server_tokens off;

    # override the client address with that sent in the X-Forwarded-For header
    set_real_ip_from    0.0.0.0/0;
    real_ip_header      X-Forwarded-For;
    real_ip_recursive   on;

    # optimize the transmission of files
    sendfile            on;
    sendfile_max_chunk  20m;
    tcp_nopush          on;

    # enable resetting of timed-out connections to help reclaim memory
    reset_timedout_connection   on;

    # double most defaults for hash tables to reduce the chance of failing to build
    map_hash_bucket_size            64;
    server_names_hash_max_size      1024;
    server_names_hash_bucket_size   32;
    types_hash_max_size             2048;
    variables_hash_bucket_size      64;
    variables_hash_max_size         2048;

    # set the default MIME type for responses
    include mime.types;
    default_type text/html;

    # disable warnings about uninitialized variables
    uninitialized_variable_warn off;

    # enable logging of requests
    map $request_uri $loggable {
        default 1;
    }

    # configure logging
    log_format upstreaminfo '$remote_addr - [$remote_addr] - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent" $request_length $request_time [$proxy_upstream_name] $upstream_addr $upstream_response_length $upstream_response_time $upstream_status';
    access_log      /dev/stdout upstreaminfo if=$loggable;
    error_log       /dev/stderr notice;
    log_subrequest  on;

    # retain the default nginx handling of requests without a "Connection" header
    map $http_upgrade $connection_upgrade {
        default          upgrade;
        ''               close;
    }

    map $http_x_forwarded_port $pass_server_port {
       default           $server_port;
    }

    # map port 442 to 443 for header X-Forwarded-Port
    map $pass_server_port $pass_port {
        442              443;
        default          $pass_server_port;
    }

    # Map a response error watching the header Content-Type
    map $http_accept $httpAccept {
        default          html;
        application/json json;
        application/xml  xml;
        text/plain       text;
    }

    map $httpAccept $httpReturnType {
        default          text/html;
        json             application/json;
        xml              application/xml;
        text             text/plain;
    }

    # Obtain best http host
    map $http_host $this_host {
        default          $http_host;
        ''               $host;
    }

    map $http_x_forwarded_host $best_http_host {
        default          $this_host;
    }

    # disable specifying the port in absolute redirects issued by nginx
    port_in_redirect    off;

    server {
      listen 8081;

      location /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'OK';
      }
    }

    server {
        server_name _;
        set $proxy_upstream_name "-";
        set $true 0;
        listen 8080 default_server reuseport backlog=511;

        client_max_body_size    0;
        port_in_redirect        off;
        proxy_connect_timeout   5s;
        proxy_redirect          off;
        proxy_http_version      1.1;
        proxy_buffer_size       "128k";
        proxy_buffers           4 "256k";

        # set custom headers in requests to proxied server
        proxy_set_header Host               $best_http_host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Original-URI     $request_uri;
        proxy_set_header X-Scheme           https;

        # allow WebSocket connections
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        # mitigate HTTPoxy Vulnerability
        # https://www.nginx.com/blog/mitigating-the-httpoxy-vulnerability-with-nginx/
        proxy_set_header Proxy              "";

        # in case of errors, try the next upstream server before returning an error
        proxy_next_upstream                 error timeout invalid_header http_502 http_503 http_504;

        # health checks in cloud providers require the use of port 80
        location /healthz {
            access_log off;
            return 200;
        }

        # this is required to avoid error if nginx is being monitored
        # with an external software (like sysdig)
        location /nginx_status {
            allow 127.0.0.1;
            allow ::1;
            deny all;

            access_log off;
            stub_status on;
        }

        location / {
            proxy_pass http://@@FULLNAME@@-gatekeeper:3001;
	        proxy_hide_header Cache-Control;
            proxy_hide_header Pragma;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";

            proxy_set_header   Connection keep-alive;
            proxy_set_header   Host $host;
            proxy_cache_bypass $http_upgrade;

            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
	        proxy_set_header   X-Forwarded-Proto https;

	        # WebSocket support
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";

            # Support non 443 installs
                    }

        # Toggle whether the Keycloak admin console/API is reachable via frontdoor at all
        # (CISC-7391 -- a coarser alternative to an IP allowlist: fully on or fully off,
        # not per-network). ^~ /auth/admin is more specific than the plain /auth block
        # below, so nginx always prefers this one for admin paths regardless of file order.
        location ^~ /auth/admin {
@@ADMIN_BLOCK@@
                    }

        # Regular user-facing endpoints (SSO/login, /auth/realms/*, etc.) -- always
        # reachable regardless of admin_console_enabled above.
        location ^~ /auth {
            proxy_pass http://@@FULLNAME@@-identity:8080;

            proxy_hide_header Cache-Control;
            proxy_hide_header Pragma;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";

            proxy_set_header   Connection keep-alive;
            proxy_set_header   Host $host;
            proxy_cache_bypass $http_upgrade;

            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto https;

            # Support non 443 installs
                    }

        location ^~ /api/public/ {
            proxy_pass http://@@FULLNAME@@-scarpy:8088;

            proxy_hide_header Cache-Control;
            proxy_hide_header Pragma;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";

            proxy_set_header   Connection keep-alive;
            proxy_set_header   Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto https;

            # Support non 443 installs
                    }
    }
}
