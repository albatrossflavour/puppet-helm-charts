{
  "assessor_upgrade": {
    "variables": {},
    "resources": {
      "complyadm::runtime::run[$container['name']]": {
        "after": "$container['after']",
        "cmd": "$container['cmd']",
        "env_file": [
          "$init_env"
        ],
        "env_secrets": "$container['env_secrets']",
        "extra_parameters": "$container['extra_parameters']",
        "extra_systemd_parameters": "$container['extra_systemd_parameters']",
        "image": "$container['image']",
        "install_runtime": "$container['install_runtime']",
        "installation_dir": "$config['installation_dir']",
        "installation_group": "$config['installation_group']",
        "installation_user": "$config['installation_user']",
        "net": "$container['net']",
        "pull_on_start": "false",
        "require": [
          "File[$init_env]"
        ],
        "runtime": "$container['runtime']",
        "systemd_unit_dir": "$config['systemd_unit_dir']"
      },
      "file[$init_env]": {
        "content": "epp('complyadm/comply_env.epp', { env_vars => $env_vars })",
        "ensure": "file",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'",
        "show_diff": "false"
      }
    }
  },
  "frontdoor": {
    "variables": {
      "cert_chain": "\"${installation_dir}/comply_certs/cert_chain.pem\"",
      "conf_file": "\"${installation_dir}/frontdoor_proxy_nginx.conf\"",
      "crl": "\"${installation_dir}/comply_certs/crl.pem\"",
      "private_key": "\"${installation_dir}/comply_certs/private_key.pem\""
    },
    "resources": {
      "complyadm::runtime::run[$container['name']]": {
        "after": "$container['after']",
        "before_start": "$before_start",
        "extra_parameters": "$container['extra_parameters']",
        "extra_systemd_parameters": "$container['extra_systemd_parameters']",
        "image": "$container['image']",
        "install_runtime": "$container['install_runtime']",
        "installation_dir": "$config['installation_dir']",
        "installation_group": "$config['installation_group']",
        "installation_user": "$config['installation_user']",
        "net": "$container['net']",
        "ports": "$container['ports']",
        "pull_on_start": "false",
        "runtime": "$container['runtime']",
        "systemd_unit_dir": "$config['systemd_unit_dir']",
        "volumes": [
          "\"${conf_file}:/etc/nginx/nginx.conf\"",
          "\"${installation_dir}/comply_certs:/certs\"",
          "\"${installation_dir}/nginx_healthcheck.sh:/health/nginx_healthcheck.sh\""
        ]
      },
      "file[$cert_chain]": {
        "content": "$config['cert_chain']",
        "ensure": "'file'",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'"
      },
      "file[$conf_file]": {
        "content": "epp('complyadm/frontdoor/nginx_conf.epp', { runtime => $container['runtime'], application_port => $config['application_port'], admin_console_enabled => $config['admin_console_enabled'], })",
        "ensure": "'file'",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'"
      },
      "file[$crl]": {
        "content": "$config['crl']",
        "ensure": "'file'",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'"
      },
      "file[$healthcheck_file]": {
        "content": "epp('complyadm/runtime/service-watchdog.epp', { healthcheck => \"${container['runtime']} exec ${container['name']} ${container['healthcheck']}\" })",
        "ensure": "file",
        "group": "$config['installation_group']",
        "mode": "'+x'",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'",
        "show_diff": "false"
      },
      "file[$private_key]": {
        "content": "$config['private_key']",
        "ensure": "'file'",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'"
      }
    }
  },
  "gatekeeper": {
    "variables": {
      "conf_file": "\"${installation_dir}/oauth2_proxy.cfg\""
    },
    "resources": {
      "complyadm::runtime::run[$container['name']]": {
        "after": "$container['after']",
        "cmd": "$container['cmd']",
        "extra_parameters": "$container['extra_parameters']",
        "extra_systemd_parameters": "{ 'Service' => { 'RestartSec' => 30 }, }",
        "image": "$container['image']",
        "install_runtime": "$container['install_runtime']",
