      },
      "file[$conf_file]": {
        "content": "epp('complyadm/gatekeeper/oauth2_proxy.cfg.epp', { 'application_port' => $config['application_port'], 'client_secret' => $config['client_secret'], 'cookie_secret' => $config['cookie_secret'], 'host_fqdn' => $config['hostname'], 'scarpy' => $config['scarpy'], 'graphql' => $config['graphql'], 'ui' => $config['ui'], })",
        "ensure": "'file'",
        "group": "$config['installation_group']",
        "notify": "Complyadm::Runtime::Run[$container['name']]",
        "owner": "$config['installation_user']",
        "seltype": "'container_file_t'"
      }
    }
  },
