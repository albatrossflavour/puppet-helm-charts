    "mtls_proxy": {
      "variables": {
        "conf_file": "\"${installation_dir}/mtls_proxy_nginx.conf\"",
        "tls_crt": "\"${installation_dir}/pe_certs/tls.crt\"",
        "tls_key": "\"${installation_dir}/pe_certs/tls.key\""
      },
