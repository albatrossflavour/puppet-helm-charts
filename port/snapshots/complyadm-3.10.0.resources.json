    "postgres": {
      "variables": {
        "conf_file": "\"${installation_dir}/postgresql.conf\"",
        "hba_file": "\"${installation_dir}/pg_hba.conf\"",
        "init_script": "'/etc/puppetlabs/comply/initdb.sql'",
        "pgconf": "\"${postgres_dir}/conf\"",
        "pgdata": "\"${postgres_dir}/data\"",
        "postgres_dir": "'/bitnami/postgresql'",
        "postgres_env": "\"${installation_dir}/postgres.env\""
      },
      "lists": {
        "env_vars": [
          [
            "$container['env_vars']",
            ".keys"
          ]
        ],
        "require": [
          [
            "File[$conf_file]",
            "File[$postgres_env]",
            "File[$hba_file]"
          ],
          [
            "File[$init_script]",
            "File[$conf_file]",
            "File[$postgres_env]",
            "File[$hba_file]"
          ]
        ],
        "volumes": [
          [
            "\"postgres:${postgres_dir}\"",
            "\"${conf_file}:${pgconf}/postgresql.conf\"",
            "\"${hba_file}:${pgconf}/pg_hba.conf\""
          ],
          [
            "\"postgres:${postgres_dir}\"",
            "\"${init_script}:/docker-entrypoint-initdb.d/initdb.sql\"",
            "\"${conf_file}:${pgconf}/postgresql.conf\"",
            "\"${hba_file}:${pgconf}/pg_hba.conf\""
          ]
        ]
      },
      "resources": {
        "complyadm::runtime::run[$container['name']]": {
          "after_create": "$store_volumes_file",
          "before_start": "$before_start",
          "before_stop": "\"/usr/bin/${container['runtime']} exec ${container['name']} pg_ctl stop --mode=fast --pgdata=${pgdata}\"",
          "cmd": "\"-c config_file=${pgconf}/postgresql.conf -c hba_file=${pgconf}/pg_hba.conf\"",
          "env_file": [
            "$postgres_env"
          ],
          "env_secrets": "$container['env_secrets']",
          "extra_parameters": "\"--platform=linux/amd64 ${container['extra_parameters']}\"",
          "extra_systemd_parameters": "$container['extra_systemd_parameters']",
          "image": "$container['image']",
          "install_runtime": "$container['install_runtime']",
          "installation_dir": "$config['installation_dir']",
          "installation_group": "$config['installation_group']",
          "installation_user": "$config['installation_user']",
          "mnt_secrets": "$container['mnt_secrets']",
          "net": "$container['net']",
          "ports": "$container['ports']",
          "pull_on_start": "false",
          "require": "$require",
          "runtime": "$container['runtime']",
          "systemd_unit_dir": "$config['systemd_unit_dir']",
          "volumes": "$volumes"
        },
        "complyadm::runtime::volume['postgres']": {
          "ensure": "'present'",
          "runtime": "$container['runtime']"
        },
        "file[$conf_file]": {
          "content": "epp('complyadm/postgres/postgresql.conf.epp', { log_level => $config['log_level'] })",
          "ensure": "'file'",
          "group": "$config['installation_group']",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'"
        },
        "file[$hba_file]": {
          "ensure": "'file'",
          "group": "$config['installation_group']",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'",
          "source": "$hba"
        },
        "file[$healthcheck_file]": {
          "content": "epp('complyadm/runtime/service-watchdog.epp', { healthcheck => \"${container['runtime']} exec ${container['name']} ${container['healthcheck']}\" })",
          "ensure": "file",
          "group": "$config['installation_group']",
          "mode": "'+x'",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'",
          "show_diff": "false"
        },
        "file[$init_script]": {
          "content": "epp('complyadm/postgres/initdb.sql.epp', { 'comply_db_username' => $config['comply_db_username'], 'comply_db_password' => $config['comply_db_password'], 'identity_db_username' => $config['identity_db_username'], 'identity_db_password' => $config['identity_db_password'], })",
          "ensure": "'file'",
          "group": "$config['installation_group']",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'"
        },
        "file[$postgres_env]": {
          "content": "epp('complyadm/comply_env.epp', { env_vars => $env_vars })",
          "ensure": "file",
          "group": "$config['installation_group']",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'",
          "show_diff": "false"
        },
        "file[$remove_volumes_file]": {
          "content": "\"for volume in $(cat ${installation_dir}/${container['name']}-volumes.txt); do /usr/bin/${container['runtime']} volume rm --force \\$volume;done\"",
          "ensure": "file",
          "group": "$config['installation_group']",
          "mode": "'+x'",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'",
          "show_diff": "false"
        },
        "file[$store_volumes_file]": {
          "content": "\"/usr/bin/${container['runtime']} inspect comply_postgres | grep -v postgres | grep -o 'volumes.*' | cut -d '/' -f 2 > ${installation_dir}/${container['name']}-volumes.txt\"",
          "ensure": "file",
          "group": "$config['installation_group']",
          "mode": "'+x'",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'",
          "show_diff": "false"
        }
      }
    },
