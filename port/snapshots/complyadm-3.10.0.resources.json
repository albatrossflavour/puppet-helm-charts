        "file[$conf_file]": {
          "content": "epp('complyadm/frontdoor/nginx_conf.epp', { runtime => $container['runtime'], application_port => $config['application_port'], admin_console_enabled => $config['admin_console_enabled'], })",
          "ensure": "'file'",
          "group": "$config['installation_group']",
          "notify": "Complyadm::Runtime::Run[$container['name']]",
          "owner": "$config['installation_user']",
          "seltype": "'container_file_t'"
